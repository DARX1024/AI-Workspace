# OS & Editor junk
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Disposable scratch areas (keep directory structure via .gitkeep)
spaces/*/scratch/*
!spaces/*/scratch/.gitkeep

# Generated local gallery (rebuilt via tools/build_gallery.ps1)
gallery.html

# Common runtime caches & heavy dependencies
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.cache/
*.tmp
*.log
